# Isolated comparison environment. These image versions are test inputs.
PARITY_PYTHON_IMAGE=python:3.12-slim-trixie
PARITY_RUST_IMAGE=rust:1.96-slim-trixie
PARITY_RUNTIME_IMAGE=debian:trixie-slim
PARITY_UV_VERSION=0.11.17
PARITY_BIND_HOST=0.0.0.0
PARITY_REFERENCE_PORT=4000
PARITY_NATIVE_PORT=4001
PARITY_MOCK_PORT=8000
PARITY_STARTUP_SECONDS=90
# Set PARITY_MASTER_KEY and PARITY_SUBJECT in the invoking environment.
# PARITY_MASTER_KEY must be an ephemeral random test key, never a live API key.
