# Copy to deploy/.env; keep secrets out of Git.
LLM_UNIFY_IMAGE=llm-unify:0.1.0
RUST_IMAGE=rust:1.96-slim-trixie
RUNTIME_IMAGE=debian:trixie-slim
BUILD_JOBS=2
PROXY_BIND_ADDRESS=127.0.0.1
PROXY_PORT=4000
PROXY_CONTAINER_PORT=4000
PROXY_MEMORY_LIMIT=1g
PROXY_PID_LIMIT=256
PROXY_TMPFS_SIZE=16m
PROXY_STOP_GRACE_PERIOD=30s
PROXY_HEALTH_INTERVAL=30s
PROXY_HEALTH_TIMEOUT=5s
PROXY_HEALTH_RETRIES=3
PROXY_HEALTH_START_PERIOD=15s
PROXY_HEALTH_CURL_TIMEOUT=3
# Generate a fresh random value, e.g. openssl rand -hex 32.
LLM_UNIFY_MASTER_KEY=
UPSTREAM_API_BASE=
UPSTREAM_API_KEY=
